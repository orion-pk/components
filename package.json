  "description": "Shared Component Library & Design System for Orion Apps (Academy, Medicare, POS)",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "style": "dist/style.css",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
